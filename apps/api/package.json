{
  "name": "@retailos/api",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "start": "node dist/main.js",
    "migrate": "node scripts/migrate.mjs",
    "generate:openapi": "node dist/openapi.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1084.0",
    "@aws-sdk/s3-request-presigner": "^3.1084.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "@sentry/node": "^8.50.0",
    "argon2": "^0.41.1",
    "drizzle-orm": "^0.38.3",
    "express-session": "^1.18.1",
    "nestjs-pino": "^4.3.0",
    "otplib": "^12.0.1",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ulid": "^2.3.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.15",
    "@eslint/js": "^9.18.0",
    "@retailos/config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22",
    "@types/pg": "^8.11.10",
    "eslint": "^9.18.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  }
}
