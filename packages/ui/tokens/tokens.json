{
  "$description": "Counter design tokens — source of truth is 04-design/design-system.md. tokens.css is generated from this file by scripts/build-tokens.mjs (run via the package build); React Native consumes this JSON directly.",
  "color": {
    "light": {
      "primary": "#1A4D2E",
      "primary-hover": "#143D24",
      "accent": "#F5A623",
      "success": "#1E8E3E",
      "warning": "#F29900",
      "danger": "#D93025",
      "bg": "#F7F8F7",
      "surface": "#FFFFFF",
      "ink": "#1C1F1D",
      "ink-muted": "#5C6660",
      "border": "#E2E6E3"
    },
    "dark": {
      "primary": "#5CB584",
      "primary-hover": "#6FC494",
      "accent": "#F5B84D",
      "success": "#4CC272",
      "warning": "#F5A623",
      "danger": "#F0655A",
      "bg": "#121513",
      "surface": "#1C201D",
      "ink": "#E8ECE9",
      "ink-muted": "#98A29C",
      "border": "#2B302D"
    }
  },
  "typography": {
    "family": {
      "ui": "Inter, system-ui, -apple-system, sans-serif",
      "money": "JetBrains Mono, ui-monospace, SFMono-Regular, monospace"
    },
    "sizePx": {
      "caption": 12,
      "body-sm": 14,
      "body": 16,
      "pos-body": 18,
      "h3": 20,
      "h2": 24,
      "h1": 30,
      "pos-total": 40
    },
    "weights": [400, 500, 600]
  },
  "spacingPx": [8, 12, 16, 24, 32],
  "radiusPx": { "default": 8, "card": 12, "pill": 9999 },
  "shadow": {
    "card": "0 1px 3px rgba(28, 31, 29, 0.10)",
    "overlay": "0 8px 24px rgba(28, 31, 29, 0.18)"
  },
  "touchPx": { "pos-min-target": 48, "admin-control": 36 },
  "motion": { "state-ms": 120, "sheet-ms": 200 }
}
