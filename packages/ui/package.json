{
  "name": "@retailos/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens/tokens.css": "./tokens/tokens.css",
    "./tokens/tokens.json": "./tokens/tokens.json",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "node scripts/build-tokens.mjs && tsc -p tsconfig.build.json",
    "typecheck": "node scripts/build-tokens.mjs && tsc --noEmit",
    "lint": "eslint src",
    "test": "echo 'ui: visual review via Storybook in Phase 0'",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "node scripts/build-tokens.mjs && storybook build"
  },
  "dependencies": {
    "@retailos/domain": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@retailos/config": "workspace:*",
    "@storybook/react": "^8.5.0",
    "@storybook/react-vite": "^8.5.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "postcss": "^8.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^5.4.0"
  }
}
